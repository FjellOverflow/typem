{
  "name": "typem",
  "version": "1.1.3",
  "private": true,
  "description": "Type out the list items as quickly as possible.",
  "homepage": "https://github.com/FjellOverflow/typem",
  "bugs": {
    "url": "https://github.com/FjellOverflow/typem/issues"
  },
  "license": "GPL-3.0-only",
  "author": "FjellOverflow",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite build && vite preview",
    "test:unit": "vitest run",
    "test:unit:dev": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e --browser chrome'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e --browser chrome'",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "release": "eslint . && prettier --check src && commit-and-tag-version --sign"
  },
  "dependencies": {
    "@lucide/vue": "^1.71.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "baseline-browser-mapping": "^2.11.35",
    "caniuse-lite": "^1.0.30001823",
    "daisyui": "^5.7.50",
    "flag-icons": "^7.6.0",
    "shepherd.js": "^15.3.0",
    "tailwindcss": "^4.3.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue-i18n": "^11.4.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "commit-and-tag-version": "^13.3.0",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.4",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-tsc": "^3.3.14"
  }
}
